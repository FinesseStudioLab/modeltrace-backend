# ModelTrace API
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
AUDIT_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
USAGE_METER_CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
PAYMENT_ROUTER_CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC

# Reported by GET /meta so a deployed instance can be identified. Injected by
# CI at build time (e.g. BUILD_SHA=${{ github.sha }}) — the running
# container has no .git directory, so these are never derived at runtime.
# BUILD_SHA=
# BUILD_TIME=

# --- Signing key custody (docs/adr/0001-soroban-signing-key-custody.md) ---
# This service NEVER signs value movement. Settlement is returned to the caller
# as an unsigned envelope. The only key that may exist here is a low-privilege
# attestation key, scoped on-chain to attestation entry points.
#
# null : default. Every signing attempt throws. Correct until attestation ships.
# kms  : production. Signing happens inside the KMS; the key never enters memory.
# env  : LOCAL DEVELOPMENT ONLY. Documented interim risk; refused when
#        NODE_ENV=production. Must never be an account that holds funds.
SIGNING_PROVIDER=null
# SIGNING_KMS_KEY_ID=
# SIGNING_ENV_SECRET_KEY=

# --- Operational guardrails ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576
